{
  "name": "lambdafolio",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint:frontmatter": "node scripts/lint-frontmatter.mjs",
    "lint:body": "node scripts/lint-body.mjs",
    "lint:markdown": "markdownlint-cli2",
    "generate:taxonomy": "node scripts/generate-taxonomy.mjs",
    "lint:taxonomy": "node scripts/generate-taxonomy.mjs --check",
    "lint:spelling": "cspell --no-progress --no-summary \"content/**/*.md\" \"docs/*.md\" \"*.md\"",
    "check:filters": "node --experimental-strip-types scripts/check-filters.mts",
    "lint:all": "npm run lint:frontmatter && npm run lint:body && npm run lint:taxonomy && npm run lint:markdown && npm run lint:spelling && npm run check:filters",
    "dotenvx:encrypt:local": "dotenvx encrypt -f .env.local",
    "dotenvx:decrypt:local": "dotenvx decrypt -f .env.local",
    "dotenvx:encrypt:production": "dotenvx encrypt -f .env.production",
    "dotenvx:decrypt:production": "dotenvx decrypt -f .env.production",
    "dotenvx:set:local": "dotenvx set -f .env.local",
    "dotenvx:set:production": "dotenvx set -f .env.production",
    "scaffold:paradigms": "node scripts/scaffold-paradigms.mjs",
    "scaffold:features": "node scripts/scaffold-features.mjs",
    "scaffold:families": "node scripts/scaffold-families.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bubble-menu": "^3.31.4",
    "@tiptap/extension-code": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-drag-handle": "^3.31.4",
    "@tiptap/extension-drag-handle-vue-3": "^3.31.4",
    "@tiptap/extension-floating-menu": "^3.31.4",
    "@tiptap/extension-horizontal-rule": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-node-range": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vueuse/integrations": "^14.4.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.6.0",
    "nuxt-studio": "^1.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@barzhsieh/nuxt-content-mermaid": "^4.0.1",
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/node": "^26.6.5",
    "cspell": "^10.4.1",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.24.0",
    "nuxt-module-feed": "^1.1.4",
    "vue-tsc": "3.3.13",
    "yaml": "^2.9.1"
  }
}
