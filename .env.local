#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_LOCAL="0301e9b1d894c68b66b9a6ad011849da792175522613bf9f1cc3098211d5a5fff0"

# .env.local
# Environment template — the shape every .env.<env> file takes.
#
# Once encrypted, the `.env.<env>` files ARE committed: they are ciphertext, safe
# to publish. `.env.keys` holds the private keys and must never be committed —
# back it up somewhere safe, because losing it means re-encrypting every file.
#
#   cp .env.example .env.local
#   npm run dotenvx:set:local BRAVE_API_KEY "…"   # writes encrypted:… values
#   npm run dotenvx:encrypt:local                  # adds DOTENV_PUBLIC_KEY_LOCAL
#
# The private key goes to GitHub as a repository secret:
#   DOTENV_PRIVATE_KEY_LOCAL       (for CI on pull requests)
#   DOTENV_PRIVATE_KEY_PRODUCTION  (for the deployed site and triage)
#
# Why encrypted-and-committed rather than Actions secrets alone: the same values
# are needed by a local session and by CI, so ciphertext in the repo keeps one
# source of truth and stops "what my shell has" from drifting from what the
# runner has.

# Brave Search REST API — used by scripts/research.mjs.
# Free credit is ~1,000 queries/month; see docs/suggestion-intake-plan.md §10.
BRAVE_API_KEY=encrypted:BDPCDTUp4QAAIGEspGuFp2WzoCHvdEq6GG+7aOOYoSpmfAa5vTdLAmumWGhfbEWhmVdk3APfcOkuJMpKlGY4gi/Vktu7honn4+gg0wGTMJe9qN0/+InmEsJtspxJbbZIrkVyaTN5ex4I0bpOQ+OCJbXX9bMdlg3c2HCzeHNJi0w=

