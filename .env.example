# Environment template — copy to `.env.local` and encrypt.
#
# This file is committed UNENCRYPTED and holds no secrets. It documents which
# keys exist so a fresh checkout knows what to provide.
#
#   cp .env.example .env.local
#   npm run dotenvx:encrypt:local     # writes DOTENV_PUBLIC_KEY_LOCAL into it
#   npm run dotenvx:set:local BRAVE_API_KEY "…"
#
# The private key lands in `.env.keys` (git-ignored). Back it up somewhere safe:
# losing it means re-encrypting every committed env file.
#
# Why encrypted-and-committed rather than GitHub Actions secrets: the same
# values are needed by a local session (running `scripts/research.mjs` by hand)
# and by CI. Committing ciphertext means one source of truth and no drift
# between "what my shell has" and "what the runner has".

# Brave Search REST API — used by scripts/research.mjs.
# Free credit is ~1,000 queries/month; see docs/suggestion-intake-plan.md §10.
BRAVE_API_KEY=

# Ollama Cloud — used by scripts/parse-submission.mjs and scripts/extract-facts.mjs.
# Pay-as-you-go concurrency is 3 requests; see §6.2.
OLLAMA_API_KEY=
