{
  // Workspace settings for the lambdafolio corpus.
  //
  // THE AUTHORITATIVE SPELLING GATE IS cspell (`npm run lint:spelling`), not the
  // editor. It enables both the en-US and en-GB dictionaries, so both dialects
  // pass and only real typos fail. A clean editor does not mean the corpus
  // passes — run the lints.
  //
  // The editor's LTeX extension ships its own dictionary and flags British
  // spellings ("programme", "scepticism") as mistakes under en-US. Forcing
  // en-GB instead is worse: it flags the dominant US spelling ("color"),
  // which is what most of the corpus uses. So the handful of existing British
  // forms are whitelisted here, leaving genuine new typos visible. Fix the
  // prose for a real misspelling; add a word here only when it is deliberate.
  "ltex.language": "en-US",
  "ltex.dictionary": {
    "en-US": [
      "colour",
      "colours",
      "coloured",
      "behaviour",
      "behavioural",
      "licence",
      "formalisation",
      "formalising",
      "monomorphisation",
      "synchronisation",
      "travelled",
      "unsanitised",
      "commercialised",
      "programme",
      "programmes",
      "sceptical",
      "scepticism"
    ]
  },

  // Keep the editor's cspell integration on the same project word list the CLI
  // gate uses, so both agree on domain vocabulary.
  "cSpell.enabled": true,

  // The Ollama extension defaults to http://127.0.0.1:11434, which inside the dev
  // container is the CONTAINER, not the host. `host.docker.internal` is mapped to
  // the host gateway by .devcontainer/compose.yml (extra_hosts), so the extension
  // reaches an Ollama server running on the host machine.
  "ollama.endpoint": "http://host.docker.internal:11434",

  "[markdown]": {
    "editor.wordWrap": "on"
  }
}
